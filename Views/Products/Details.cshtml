@using AuthOnlineApp.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@model Product

@{
    ViewData["Title"] = "Details";
}

@{
    var searchUsername = Context.Request.Query["searchUsername"].ToString();
    var minAmountStr = Context.Request.Query["minAmount"].ToString();
    var maxAmountStr = Context.Request.Query["maxAmount"].ToString();
    var filterDateStr = Context.Request.Query["filterDate"].ToString();

    decimal.TryParse(minAmountStr, out var minAmount);
    decimal.TryParse(maxAmountStr, out var maxAmount);
    DateTime.TryParse(filterDateStr, out var filterDate);

    var currentUserId = UserManager.GetUserId(User);
}

<style>
    body {
        background: #f9f9f9;
        font-family: 'Arial', sans-serif;
    }

    h2 {
        color: #343a40;
        font-size: 36px;
        font-weight: 700;
        text-align: center;
        margin-top: 50px;
        margin-bottom: 30px;
    }

    .product-details {
        background-color: #ffffff;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 40px;
    }

        .product-details p {
            font-size: 18px;
            color: #6c757d;
        }

        .product-details strong {
            color: #343a40;
        }

        .product-details img {
            max-width: 300px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

    .filter-form {
        background-color: #ffffff;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin-bottom: 30px;
    }

    .product-bids-table {
        width: 100%;
        margin-top: 20px;
        border-collapse: collapse;
    }

        .product-bids-table th, .product-bids-table td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
        }

        .product-bids-table th {
            background-color: #007bff;
            color: white;
        }

    .action-links {
        text-align: center;
        margin-top: 30px;
    }
</style>

<div class="container">
    <h2>Product Details</h2>

    <div class="product-details">
        <p><strong>Name:</strong> @Model.Name</p>
        <p><strong>Description:</strong> @Model.Description</p>
        <p><strong>Starting Price:</strong> @Model.StartingPrice</p>
        <p><strong>Deadline:</strong> @Model.Deadline</p>
        <p><strong>Created By:</strong> @Model.CreatedByUser?.UserName</p>
        <p><img src="@Model.ImageUrl" alt="Product Image" /></p>
    </div>

    <h4>Filter Bids</h4>
    <form method="get" class="filter-form row g-2 mb-3">
        <input type="hidden" name="id" value="@Model.ProductId" />

        <input type="text" name="searchUsername" value="@searchUsername" placeholder="Username" />
        <input type="number" name="minAmount" step="0.01" value="@minAmountStr" placeholder="Min Amount" />
        <input type="number" name="maxAmount" step="0.01" value="@maxAmountStr" placeholder="Max Amount" />
        <input type="date" name="filterDate" value="@filterDateStr" />

        <button>Filter</button>
    </form>

    @if (Model.Bids != null && Model.Bids.Any())
    {
        <table class="product-bids-table">
            <thead>
                <tr>
                    <th>Bidder</th>
                    <th>Amount</th>
                    <th>Placed On</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bid in Model.Bids)
                {
                    bool matchesUser = string.IsNullOrEmpty(searchUsername) || bid.User?.UserName?.Contains(searchUsername) == true;
                    bool matchesMin = string.IsNullOrEmpty(minAmountStr) || bid.Amount >= minAmount;
                    bool matchesMax = string.IsNullOrEmpty(maxAmountStr) || bid.Amount <= maxAmount;
                    bool matchesDate = string.IsNullOrEmpty(filterDateStr) || bid.CreatedAt.Date == filterDate.Date;

                    if (matchesUser && matchesMin && matchesMax && matchesDate)
                    {
                        <tr>
                            <td>@bid.User?.UserName</td>
                            <td>@bid.Amount</td>
                            <td>@bid.CreatedAt</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No bids found.</p>
    }

    <div class="action-links">

        @if (User.Identity.IsAuthenticated)
        {
            if (Model.CreatedByUserId == currentUserId)
            {
                <p style="color:red;">You can't bid for your own product.</p>
            }
            else
            {
                <a asp-controller="Bids"
                   asp-action="Create"
                   asp-route-productId="@Model.ProductId"
                   class="btn btn-success">
                    Bid
                </a>
            }
        }
        else
        {
            <p style="color:red;">You must log in to bid.</p>
            <a href="/Identity/Account/Login" class="btn btn-primary">Login</a>
        }

        <br /><br />

        <a asp-action="Edit" asp-route-id="@Model.ProductId">Edit</a> |
        <a asp-action="Index">Back to My Products</a>
    </div>
</div>